# Bogoboom – hardened nginx vhost (works behind Cloudflare/ALB or directly with certbot).
# Layout on the server:
#   /var/www/html/bogoboom_project/public            -> static site (nginx root)
#   /var/www/html/bogoboom_project/backend/profiles  -> PHP endpoints (ONLY those listed below are executable)
#   /var/www/html/bogoboom_project/backend/profiles/lib  -> includes (never reachable from the web)
#   /var/lib/bogoboom/uploads                        -> uploads, OUTSIDE web root (UPLOADS_DIR)
#   /etc/bogoboom/env                                -> secrets (chmod 640 root:www-data), never in git

server_tokens off;

# Redirect HTTP -> HTTPS (certbot or Cloudflare "Full (strict)" origin cert)
server {
    listen 80;
    server_name bogoboom.com www.bogoboom.com;
    return 301 https://bogoboom.com$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name bogoboom.com www.bogoboom.com;

    ssl_certificate     /etc/letsencrypt/live/bogoboom.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bogoboom.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root /var/www/html/bogoboom_project/public;
    index index.html;

    # Uploads are small CVs (app limit 5 MB). Keep the edge limit close to it.
    client_max_body_size 6M;
    client_body_timeout 15s;
    client_header_timeout 15s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;

    # Per-IP request throttling (the PHP code also rate-limits per action)
    # (limit_req_zone must live in the http{} context, e.g. /etc/nginx/conf.d/bogoboom-limits.conf:
    #    limit_req_zone $binary_remote_addr zone=bb_api:10m rate=10r/s;)
    # Uncomment the limit_req line below once the zone exists.

    # Static files: no PHP is ever executed from the static root.
    location / {
        try_files $uri $uri/ =404;
    }
    location ~ \.php$ { return 404; }

    # Never serve dotfiles, VCS, dependency, SQL, config or log artefacts
    location ~ /\.            { deny all; }
    location ~* \.(sql|env|log|bak|old|orig|swp|lock|md)$ { deny all; }
    location ~* /(vendor|lib|uploads|node_modules|\.git)(/|$) { deny all; }
    location ~* /composer\.(json|lock)$ { deny all; }

    # ---- PHP: strict allowlist of public endpoints (exact matches only) ----
    location ~ ^/backend/profiles/(login|register|csrf|change_password|toggle_user_status|default_profile|submit_newcomers|submit_agencies|submit_companies|submit_lead|partner_inquiry|chatbot|social_login_agency|social_login_company|social_login_newcomer|social_callback_agency|social_callback_company|social_callback_newcomer)\.php$ {
        root /var/www/html/bogoboom_project;
        # limit_req zone=bb_api burst=20 nodelay;

        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
        # Secrets come from /etc/bogoboom/env (read by lib/env.php), not from nginx.
        fastcgi_read_timeout 30s;
    }

    # Any other PHP below /backend (db_connection.php, helpers.php, hybridauth_*.php, lib/*, …) -> 404
    location ^~ /backend/ { return 404; }

    access_log /var/log/nginx/bogoboom.access.log;
    error_log  /var/log/nginx/bogoboom.error.log warn;
}
