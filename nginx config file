server {
    listen 80;
    server_name 15.229.154.73;

    root /var/www/html/bogoboom_project/public;
    index index.php index.html index.htm;

    client_max_body_size 50M;

    # Serve frontend files (HTML, CSS, JS, images)
    location / {
        try_files $uri $uri/ =404;
    }

    # Process PHP files in /public
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # ✅ Serve PHP files from backend/profiles
    location ~ ^/bogoboom_project/backend/profiles/(.+\.php)$ {
        alias /var/www/html/bogoboom_project/backend/profiles/$1;
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME /var/www/html/bogoboom_project/backend/profiles/$1;
        include fastcgi_params;
    }

    # ❌ Deny access to all other non-PHP files in /backend
    location ~ ^/bogoboom_project/backend/profiles/(?!.*\.php$).*$ {
        deny all;
    }

    # Deny access to hidden files like .htaccess
    location ~ /\. {
        deny all;
    }
}
