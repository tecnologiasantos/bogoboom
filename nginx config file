server {
    listen 80;
    server_name bogoboom.com www.bogoboom.com;

    # Root folder for public files like HTML, CSS, JS, images
    root /var/www/html/bogoboom_project/public;
    index index.php index.html index.htm;

    client_max_body_size 50M;

    # Serve frontend files (HTML, CSS, JS, images)
    location / {
        try_files $uri $uri/ =404;
    }

    # Process PHP files in /public (Frontend)
    location ~ ^/public/.*\.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Serve PHP files from /backend/profiles (Backend)
    location ~ ^/backend/profiles/.*\.php$ {
        # Backend root set to where backend files are located
        root /var/www/html/bogoboom_project;  # Backend files located here
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Deny access to other non-PHP files in /backend
    location ~ ^/backend/profiles/.*\.(?!php).* {
        deny all;
    }

    # Deny access to hidden files like .htaccess
    location ~ /\. {
        deny all;
    }

    # Access and error logs
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;
}
