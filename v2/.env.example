# API
DATABASE_URL=postgres://bogoboom:bogoboom@localhost:5432/bogoboom
AUTH_MODE=dev                      # dev | oidc   (dev is refused when NODE_ENV=production)
JWT_SECRET=change-me-in-dev-only-change-me-in-dev-only
OIDC_JWKS_URL=                     # e.g. https://cognito-idp.<region>.amazonaws.com/<pool>/.well-known/jwks.json
OIDC_ISSUER=
OIDC_AUDIENCE=
PAYMENT_WEBHOOK_SECRET=            # HMAC secret shared with Stripe/MercadoPago bridge
CORS_ORIGIN=http://localhost:3000
PORT=4000
# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
